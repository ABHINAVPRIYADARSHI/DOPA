# ─── Python ───────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.pdb
*.egg-info/
*.egg

# ─── Virtual Environment ──────────────────────────
.venv/
venv/
env/
venv310/

